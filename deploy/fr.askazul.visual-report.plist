<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keeps the visual-report archive reachable: `serve` starts the local server and
  the cloudflared tunnel that publishes it at https://reports.askazul.fr.

  RunAtLoad brings the pair up at login. StartInterval re-runs the same command
  every five minutes, which supervises it for free: `serve` reuses a running
  server and a running tunnel, so a live pair costs a no-op and a pair that died
  comes back within one interval. KeepAlive would be wrong here — the command
  spawns detached daemons and exits, so launchd would respawn it in a loop.

  Load:    launchctl bootstrap gui/501 ~/Library/LaunchAgents/fr.askazul.visual-report.plist
  Unload:  launchctl bootout gui/501/fr.askazul.visual-report
  Restart: launchctl kickstart -k gui/501/fr.askazul.visual-report
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>fr.askazul.visual-report</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/geoffreysaunois/.claude/skills/visual-page/bin/visual-report</string>
    <string>serve</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>300</integer>

  <!-- uv runs the package, cloudflared opens the tunnel; both live in Homebrew's bin. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/geoffreysaunois/.claude/html-reports/logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/geoffreysaunois/.claude/html-reports/logs/launchd.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
